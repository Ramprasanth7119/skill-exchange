# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# All of these come from one Supabase project: https://supabase.com/dashboard
# ---------------------------------------------------------------------------

# Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Keep ?pgbouncer=true — Prisma needs it to disable prepared statements.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Same page -> "Direct connection" (port 5432). Migrations only.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Settings -> API. The anon key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Only students with an email at this domain may sign up.
# Set to your actual college domain before the pilot.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN="example.edu"

# Public base URL, used to build magic-link redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Credits granted to a brand-new account so they can learn before they teach.
SIGNUP_BONUS_CREDITS="1"
